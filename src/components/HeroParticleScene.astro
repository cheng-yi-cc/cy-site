---
interface Props {
  avatarSrc: string;
}

const { avatarSrc } = Astro.props;
---

<div
  class="hero-scene"
  data-hero-scene
  data-avatar-src={avatarSrc}
  aria-hidden="true"
>
  <canvas></canvas>
</div>

<script>
  type Particle = {
    nx: number;
    ny: number;
    x: number;
    y: number;
    vx: number;
    vy: number;
    entranceDelay: number;
    entranceOffsetX: number;
    entranceOffsetY: number;
    entranceArcX: number;
    entranceArcY: number;
    driftX: number;
    driftY: number;
    accent: boolean;
  };

  const scene = document.querySelector<HTMLElement>('[data-hero-scene]');
  const canvas = scene?.querySelector<HTMLCanvasElement>('canvas');
  const context = canvas?.getContext('2d');
  const hero = scene?.closest<HTMLElement>('.home-hero');

  if (scene && canvas && context && hero && !scene.dataset.initialized) {
    scene.dataset.initialized = 'true';

    const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');
    const compactScreen = matchMedia('(max-width: 700px), (pointer: coarse)');
    const image = new Image();
    const particles: Particle[] = [];

    let width = 0;
    let height = 0;
    let portraitSize = 0;
    let portraitLeft = 0;
    let portraitTop = 0;
    let animationFrame = 0;
    let lastFrame = 0;
    let visible = true;
    let imageReady = false;
    let entranceComplete = false;
    let entranceStartedAt = 0;
    let gridColor = '';
    let particleColor = '';
    let particleAccent = '';

    const entranceDuration = 2500;
    const particleLimit = 1900;

    const pointer = {
      x: 0,
      y: 0,
      active: false,
    };

    const clamp01 = (value: number) => Math.max(0, Math.min(1, value));

    const smootherStep = (value: number) => {
      const progress = clamp01(value);
      return (
        progress *
        progress *
        progress *
        (progress * (progress * 6 - 15) + 10)
      );
    };

    const readSceneColors = () => {
      const styles = getComputedStyle(scene);
      gridColor = styles.getPropertyValue('--scene-grid-color').trim();
      particleColor = styles.getPropertyValue('--scene-particle-color').trim();
      particleAccent = styles
        .getPropertyValue('--scene-particle-accent')
        .trim();
    };

    const updatePortraitBounds = () => {
      const compact = compactScreen.matches;
      portraitSize = compact
        ? Math.min(width * 0.9, height * 0.58, 390)
        : Math.min(width * 0.43, height * 0.82, 560);
      const centerX = compact ? width * 0.5 : width * 0.76;
      const centerY = compact ? height * 0.295 : height * 0.51;
      portraitLeft = centerX - portraitSize / 2;
      portraitTop = centerY - portraitSize / 2;
    };

    const particleTarget = (particle: Particle) => {
      const parallaxX = pointer.active && entranceComplete
        ? ((pointer.x / Math.max(width, 1)) - 0.5) * 13
        : 0;
      const parallaxY = pointer.active && entranceComplete
        ? ((pointer.y / Math.max(height, 1)) - 0.5) * 9
        : 0;

      return {
        x: portraitLeft + particle.nx * portraitSize + parallaxX,
        y: portraitTop + particle.ny * portraitSize + parallaxY,
      };
    };

    const settleParticles = () => {
      for (const particle of particles) {
        const target = particleTarget(particle);
        particle.x = target.x;
        particle.y = target.y;
        particle.vx = 0;
        particle.vy = 0;
      }
    };

    const sampleAvatar = () => {
      if (!imageReady) return;

      const sampleSize = 350;
      const stride = 2;
      const pointLimit = particleLimit;
      const offscreen = document.createElement('canvas');
      const offscreenContext = offscreen.getContext('2d', {
        willReadFrequently: true,
      });
      if (!offscreenContext) return;

      offscreen.width = sampleSize;
      offscreen.height = sampleSize;
      offscreenContext.fillStyle = '#fff';
      offscreenContext.fillRect(0, 0, sampleSize, sampleSize);
      offscreenContext.drawImage(image, 0, 0, sampleSize, sampleSize);

      const pixels = offscreenContext.getImageData(
        0,
        0,
        sampleSize,
        sampleSize
      ).data;
      const candidates: Array<[number, number]> = [];

      for (let y = 0; y < sampleSize; y += stride) {
        for (let x = 0; x < sampleSize; x += stride) {
          const index = (y * sampleSize + x) * 4;
          const luminance =
            pixels[index] * 0.2126 +
            pixels[index + 1] * 0.7152 +
            pixels[index + 2] * 0.0722;
          if (pixels[index + 3] > 24 && luminance < 174) {
            candidates.push([x, y]);
          }
        }
      }

      particles.length = 0;
      const count = Math.min(candidates.length, pointLimit);
      const selectionStep = candidates.length / Math.max(count, 1);

      for (let i = 0; i < count; i += 1) {
        const [x, y] = candidates[Math.floor(i * selectionStep)];
        const phase = ((x * 17 + y * 29 + i * 7) % 628) / 100;
        const entranceDelay =
          ((Math.sin(phase * 2.3) + 1) / 2) * 0.075;
        const entranceDistance =
          46 + ((Math.sin(phase * 3.7) + 1) / 2) * 76;
        const entranceDirection = phase + (y / (sampleSize - 1)) * 1.25;
        particles.push({
          nx: x / (sampleSize - 1),
          ny: y / (sampleSize - 1),
          x: 0,
          y: 0,
          vx: 0,
          vy: 0,
          entranceDelay,
          entranceOffsetX: Math.cos(entranceDirection) * entranceDistance,
          entranceOffsetY: Math.sin(entranceDirection) * entranceDistance,
          entranceArcX:
            -Math.sin(entranceDirection) * entranceDistance * 0.17,
          entranceArcY:
            Math.cos(entranceDirection) * entranceDistance * 0.17,
          driftX: Math.cos(phase) * 0.65,
          driftY: Math.sin(phase) * 0.36,
          accent: i % 23 === 0,
        });
      }

      settleParticles();
    };

    const resize = () => {
      const bounds = scene.getBoundingClientRect();
      width = Math.max(1, bounds.width);
      height = Math.max(1, bounds.height);
      const pixelRatio = Math.min(devicePixelRatio || 1, 1.5);
      canvas.width = Math.round(width * pixelRatio);
      canvas.height = Math.round(height * pixelRatio);
      canvas.style.width = `${width}px`;
      canvas.style.height = `${height}px`;
      context.setTransform(pixelRatio, 0, 0, pixelRatio, 0, 0);
      updatePortraitBounds();
      if (imageReady) sampleAvatar();
      render(performance.now(), true);
    };

    const addGridPoint = (
      x: number,
      y: number,
      move: boolean,
      radius: number,
      radiusSquared: number
    ) => {
      let warpedX = x;
      let warpedY = y;

      if (pointer.active && entranceComplete && !reducedMotion.matches) {
        const dx = x - pointer.x;
        const dy = y - pointer.y;
        const distanceSquared = dx * dx + dy * dy;

        if (distanceSquared > 0.01 && distanceSquared < radiusSquared) {
          const distance = Math.sqrt(distanceSquared);
          const strength = (1 - distance / radius) ** 2 * 24;
          warpedX += (dx / distance) * strength;
          warpedY += (dy / distance) * strength;
        }
      }

      if (move) context.moveTo(warpedX, warpedY);
      else context.lineTo(warpedX, warpedY);
    };

    const drawGrid = () => {
      const spacing = compactScreen.matches ? 46 : 58;
      const segment = compactScreen.matches ? 18 : 14;
      const radius = compactScreen.matches ? 105 : 175;
      const radiusSquared = radius * radius;
      const offsetX =
        pointer.active && entranceComplete
          ? (pointer.x - width / 2) * 0.007
          : 0;
      const offsetY =
        pointer.active && entranceComplete
          ? (pointer.y - height / 2) * 0.007
          : 0;
      context.strokeStyle = gridColor;
      context.lineWidth = 0.75;

      for (let x = -spacing + offsetX; x <= width + spacing; x += spacing) {
        context.beginPath();
        for (let y = -segment; y <= height + segment; y += segment) {
          addGridPoint(
            x,
            y,
            y === -segment,
            radius,
            radiusSquared
          );
        }
        context.stroke();
      }

      for (let y = -spacing + offsetY; y <= height + spacing; y += spacing) {
        context.beginPath();
        for (let x = -segment; x <= width + segment; x += segment) {
          addGridPoint(
            x,
            y,
            x === -segment,
            radius,
            radiusSquared
          );
        }
        context.stroke();
      }
    };

    const drawParticles = (time: number, staticFrame: boolean) => {
      const entranceActive =
        imageReady && !reducedMotion.matches && !entranceComplete;
      const entranceProgress = entranceActive
        ? clamp01((time - entranceStartedAt) / entranceDuration)
        : 1;
      const interactionActive =
        pointer.active && entranceComplete && !staticFrame;
      const interactionRadius = compactScreen.matches ? 88 : 138;
      const spring = staticFrame
        ? 1
        : compactScreen.matches
          ? 0.065
          : 0.22;
      const damping = staticFrame
        ? 0
        : compactScreen.matches
          ? 0.82
          : 0.48;
      const particleSize = compactScreen.matches ? 1.15 : 1.4;
      const interactionRadiusSquared = interactionRadius * interactionRadius;
      const parallaxX = interactionActive
        ? ((pointer.x / Math.max(width, 1)) - 0.5) * 13
        : 0;
      const parallaxY = interactionActive
        ? ((pointer.y / Math.max(height, 1)) - 0.5) * 9
        : 0;
      const driftWave = reducedMotion.matches || entranceActive
        ? 0
        : Math.sin(time * 0.00055);
      const regularPath = new Path2D();
      const accentPath = new Path2D();

      for (const particle of particles) {
        let targetX =
          portraitLeft +
          particle.nx * portraitSize +
          parallaxX +
          driftWave * particle.driftX;
        let targetY =
          portraitTop +
          particle.ny * portraitSize +
          parallaxY +
          driftWave * particle.driftY;

        let sizeScale = 1;

        if (entranceActive) {
          const gather = smootherStep(
            (entranceProgress - particle.entranceDelay) /
              (0.88 - particle.entranceDelay)
          );
          const arc = Math.sin(Math.PI * gather);

          particle.x =
            targetX +
            particle.entranceOffsetX * (1 - gather) +
            particle.entranceArcX * arc;
          particle.y =
            targetY +
            particle.entranceOffsetY * (1 - gather) +
            particle.entranceArcY * arc;
          particle.vx = 0;
          particle.vy = 0;
          sizeScale = 0.66 + gather * 0.34;
        } else {
          if (interactionActive) {
            const dx = targetX - pointer.x;
            const dy = targetY - pointer.y;
            const distanceSquared = dx * dx + dy * dy;

            if (
              distanceSquared > 0.01 &&
              distanceSquared < interactionRadiusSquared
            ) {
              const distance = Math.sqrt(distanceSquared);
              const force = (1 - distance / interactionRadius) ** 2;
              targetX +=
                (dx / distance) * force * 42 -
                (dy / distance) * force * 8;
              targetY +=
                (dy / distance) * force * 42 +
                (dx / distance) * force * 8;
            }
          }

          particle.vx =
            (particle.vx + (targetX - particle.x) * spring) * damping;
          particle.vy =
            (particle.vy + (targetY - particle.y) * spring) * damping;

          if (staticFrame) {
            particle.x = targetX;
            particle.y = targetY;
          } else {
            particle.x += particle.vx;
            particle.y += particle.vy;
          }
        }

        const size =
          (particle.accent ? particleSize * 1.45 : particleSize) * sizeScale;
        const path = particle.accent ? accentPath : regularPath;
        path.rect(particle.x, particle.y, size, size);
      }

      context.globalAlpha = entranceActive
        ? 0.12 + smootherStep(entranceProgress / 0.82) * 0.88
        : 1;
      context.fillStyle = particleColor;
      context.fill(regularPath);
      context.fillStyle = particleAccent;
      context.fill(accentPath);
      context.globalAlpha = 1;
    };

    function render(time: number, staticFrame = false) {
      context.clearRect(0, 0, width, height);
      drawGrid();
      drawParticles(time, staticFrame || reducedMotion.matches);
    }

    const animate = (time: number) => {
      if (!visible || reducedMotion.matches) {
        animationFrame = 0;
        return;
      }

      const minimumFrameTime = 1000 / 60;
      const elapsed = time - lastFrame;
      if (elapsed >= minimumFrameTime) {
        if (
          imageReady &&
          !entranceComplete &&
          time - entranceStartedAt >= entranceDuration
        ) {
          entranceComplete = true;
          settleParticles();

          if (compactScreen.matches) {
            render(time, true);
            lastFrame = time - (elapsed % minimumFrameTime);
            animationFrame = 0;
            return;
          }
        }

        render(time);
        lastFrame = time - (elapsed % minimumFrameTime);
      }
      animationFrame = requestAnimationFrame(animate);
    };

    const startAnimation = () => {
      const compactAnimationFinished =
        compactScreen.matches && entranceComplete;
      if (
        !animationFrame &&
        visible &&
        !reducedMotion.matches &&
        !compactAnimationFinished
      ) {
        animationFrame = requestAnimationFrame(animate);
      }
    };

    const stopAnimation = () => {
      if (animationFrame) cancelAnimationFrame(animationFrame);
      animationFrame = 0;
    };

    const handlePointerMove = (event: PointerEvent) => {
      if (compactScreen.matches || event.pointerType === 'touch') return;
      const bounds = scene.getBoundingClientRect();
      pointer.x = event.clientX - bounds.left;
      pointer.y = event.clientY - bounds.top;
      pointer.active = entranceComplete;
      startAnimation();
    };

    const handlePointerLeave = () => {
      pointer.active = false;
    };

    const handleMotionPreference = () => {
      if (reducedMotion.matches) {
        stopAnimation();
        pointer.active = false;
        entranceComplete = true;
        settleParticles();
        render(performance.now(), true);
      } else {
        startAnimation();
      }
    };

    const resizeObserver = new ResizeObserver(resize);
    resizeObserver.observe(scene);

    const intersectionObserver = new IntersectionObserver(
      ([entry]) => {
        visible = entry.isIntersecting && !document.hidden;
        if (visible) startAnimation();
        else stopAnimation();
      },
      { threshold: 0.01 }
    );
    intersectionObserver.observe(hero);

    const themeObserver = new MutationObserver(() => {
      readSceneColors();
      render(
        performance.now(),
        reducedMotion.matches ||
          (compactScreen.matches && entranceComplete)
      );
    });
    themeObserver.observe(document.documentElement, {
      attributes: true,
      attributeFilter: ['data-theme'],
    });

    hero.addEventListener('pointermove', handlePointerMove, { passive: true });
    hero.addEventListener('pointerleave', handlePointerLeave);
    reducedMotion.addEventListener('change', handleMotionPreference);
    compactScreen.addEventListener('change', () => {
      pointer.active = false;
      entranceStartedAt = performance.now();
      entranceComplete = reducedMotion.matches;
      resize();
      startAnimation();
    });
    document.addEventListener('visibilitychange', () => {
      visible = !document.hidden && hero.getBoundingClientRect().bottom > 0;
      if (visible) startAnimation();
      else stopAnimation();
    });

    image.addEventListener('load', () => {
      imageReady = true;
      entranceStartedAt = performance.now();
      entranceComplete = reducedMotion.matches;
      sampleAvatar();
      render(
        performance.now(),
        reducedMotion.matches ||
          (compactScreen.matches && entranceComplete)
      );
      startAnimation();
    });

    readSceneColors();
    resize();
    image.src = scene.dataset.avatarSrc ?? '';
    startAnimation();
  }
</script>
