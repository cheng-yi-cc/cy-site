---
import '../styles/global.css';
import 'katex/dist/katex.min.css';
import site from '../../config/site.json';

interface Props {
  title?: string;
  description?: string;
}

const { title, description = site.bio } = Astro.props;
const pageTitle = title ? `${title} · ${site.title}` : site.title;
const path = Astro.url.pathname;
const isActive = (p: string) =>
  p === '/' ? path === '/' : path.startsWith(p);
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link
      rel="icon"
      href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Ctext y='.9em' font-size='90'%3E%F0%9F%96%8B%3C/text%3E%3C/svg%3E"
    />
    <script is:inline>
      (() => {
        const saved = localStorage.getItem('theme');
        const theme =
          saved ||
          (matchMedia('(prefers-color-scheme: dark)').matches
            ? 'dark'
            : 'light');
        document.documentElement.dataset.theme = theme;
      })();
    </script>
    {
      site.cfAnalyticsToken && (
        <script
          is:inline
          defer
          src="https://static.cloudflareinsights.com/beacon.min.js"
          data-cf-beacon={JSON.stringify({ token: site.cfAnalyticsToken })}
        />
      )
    }
  </head>
  <body>
    <header class="site-header">
      <div class="header-inner">
        <a href="/" class="logo">{site.name}</a>
        <nav>
          <a href="/" class:list={[{ active: isActive('/') }]}>首页</a>
          <a
            href="/articles/"
            class:list={[{ active: isActive('/articles') }]}
            >文章</a
          >
          <a
            href="/projects/"
            class:list={[{ active: isActive('/projects') }]}
            >项目</a
          >
        </nav>
        <div class="header-right">
          <a
            href={site.github}
            target="_blank"
            rel="noopener noreferrer"
            class="icon-link"
            title="我的 GitHub"
          >
            <svg viewBox="0 0 16 16" aria-hidden="true">
              <path
                d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"
              ></path>
            </svg>
          </a>
          <button id="theme-toggle" class="icon-btn" title="切换主题" aria-label="切换深浅色主题">
            <svg class="stroke-icon icon-moon" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path>
            </svg>
            <svg class="stroke-icon icon-sun" viewBox="0 0 24 24" aria-hidden="true">
              <circle cx="12" cy="12" r="4"></circle>
              <path d="M12 2v2m0 16v2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M2 12h2m16 0h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
            </svg>
          </button>
        </div>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="footer-inner">
        © {new Date().getFullYear()} {site.name} · 由 Astro 构建 · 部署于
        Cloudflare Pages
      </div>
    </footer>

    <script is:inline>
      document
        .getElementById('theme-toggle')
        ?.addEventListener('click', () => {
          const root = document.documentElement;
          const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
          root.dataset.theme = next;
          localStorage.setItem('theme', next);
        });
    </script>
  </body>
</html>
